generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  BUSINESS
  USER
}
enum Category {
  It
  Health
  Food
  Education
  Entertainment
  Other
}
enum TimesEnum {
 FullTime
 PartTime
 TwentyFourHours
}

model User {
  id        Int         @id @default(autoincrement())
  name      String
  email     String      @unique
  role      UserType
  password  String
  business  Business?   @relation 
  businessId Int?       
}

model Business {
  id           Int           @id @default(autoincrement())
  description  String
  phone        String
  address      String
  location     String
  timeZone     TimesEnum
  category     Category
  website      String
  profileViews Int           @default(0)
  profileImage Bytes         
  ownerId      Int           @unique 
  owner        User          @relation(fields: [ownerId], references: [id]) 
  services     ServiceAndProduct[]  
  ratings      Rating[]      
  businessImages BusinessImage[]    
}

model ServiceAndProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       Bytes    
  businessId  Int      
  business    Business @relation(fields: [businessId], references: [id])
  bookings    Booking[] 
}

model Booking {
  id         Int         @id @default(autoincrement())
  userId     Int         
  businessId Int         
  serviceId  Int         
  status     BookingStatus?
  service    ServiceAndProduct @relation(fields: [serviceId], references: [id])
}

enum BookingStatus {
  PENDING
  COMPLETED
}

model Rating {
  id         Int       @id @default(autoincrement())
  userId     Int       
  businessId Int       
  rating     Int       
  review     String?   
  business   Business  @relation(fields: [businessId], references: [id])
}

model BusinessImage {
  id         Int      @id @default(autoincrement())
  businessId Int      
  image      Bytes    
  business   Business @relation(fields: [businessId], references: [id])
}
